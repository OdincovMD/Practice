# === Порты и хост ===
# Порт nginx на хосте (единственная точка входа снаружи)
NGINX_HOST_PORT=90

# === PostgreSQL ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pneumonia

# Полный DSN (если задан — перекрывает POSTGRES_* для backend)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/pneumonia

# === Backend (FastAPI) ===
# URL сервиса ML для прокси загрузки (внутри сети Docker)
ML_UPLOAD_URL=http://ml:9000/upload

# === Healthcheck (в секундах) ===
# HEALTHCHECK_INTERVAL=15
# HEALTHCHECK_TIMEOUT=5
# HEALTHCHECK_RETRIES=5
# ML_START_PERIOD=120
